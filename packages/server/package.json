{
  "name": "@unableset/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "unableset-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@unableset/bridge": "workspace:*",
    "@unableset/shared": "workspace:*",
    "bonjour-service": "^1.3.0",
    "express": "^4.21.2",
    "osc": "^2.4.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
